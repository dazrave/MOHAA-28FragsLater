// 28 Frags Later - OpenMOHAA (native Windows build)
// Three game modes (Survival / Outbreak / Infection), map+mode rotation,
// bot horde (melee, sprinting, herding), session survivor leaderboard.
// By DazRave (orig Ophis). Re-created from github.com/dazrave/MOHAA-28FragsLater

main:
    if (level.28fl_running)
        end
    level.28fl_running = 1
    if (int(getcvar("g_gametype")) != 2)
        end

    // ---- sounds (atmosphere) ----
    local.master = spawn ScriptMaster
    local.master aliascache thunder1 sound/amb/Amb_Thunder_01.wav soundparms 1.0 0.0 1.0 0.0 10000 10000 local streamed maps "m dm obj train "
    local.master aliascache thunder2 sound/amb/Amb_Thunder_02.wav soundparms 1.0 0.0 1.0 0.0 10000 10000 local streamed maps "m dm obj train "
    local.master aliascache creak1 sound/characters/fs_metalcreak_01.wav soundparms 0.6 0.4 0.7 0.6 160 1600 auto loaded maps "m dm obj train "
    local.master aliascache creak2 sound/characters/fs_woodcreak_01.wav soundparms 0.6 0.4 0.7 0.6 160 1600 auto loaded maps "m dm obj train "
    local.master aliascache snap1 sound/amb/Amb_BranchBreaking01.wav soundparms 1.0 0.0 1.0 0.0 500 3000 auto loaded maps "m dm obj train "
    local.master aliascache snap2 sound/amb/Amb_BranchBreaking02.wav soundparms 1.0 0.0 1.0 0.0 500 3000 auto loaded maps "m dm obj train "

    level waittill spawn

    // ---- choose the mode from the rotation index (or a fixed override) ----
    local.rot = int(getcvar("g_28fl_rot"))
    local.fixed = int(getcvar("g_28fl_mode"))
    local.modeList[1] = 3    // Survival
    local.modeList[2] = 1    // Outbreak
    local.modeList[3] = 2    // Infection
    if (local.fixed > 0)
        level.gameMode = local.fixed
    else
        level.gameMode = local.modeList[(local.rot % 3) + 1]

    // Infected are always a melee horde (survivors carry the guns)
    setcvar "g_infected_disarm" "1"

    // ---- atmosphere ----
    $world farplane 4000
    $world farplane_color ( 0.12 0.12 0.14 )
    $world farplane_cull 1
    level.28fl_survtime = 0
    level.28fl_survalive = 0
    level.28fl_survname = "---"

    thread set_mode_text
    thread storm
    thread creepy_sounds
    thread dynamic_music
    thread score_hud
    thread bot_enforcer
    thread winner_tally
    thread player_manager
    thread telemetry
    thread rotation_timer

    // ---- start the active mode ----
    if (level.gameMode == 3)
        thread mode_survival
    else if (level.gameMode == 1)
        thread mode_outbreak
    else if (level.gameMode == 2)
        thread mode_infection
end

// =====================================================================
//  Rules shown on the TAB / objectives screen + scoreboard title
// =====================================================================
set_mode_text:
    if (level.gameMode == 3)
    {
        level.28fl_modeName = "SURVIVAL"
        setcvar "g_gametypestring" "28FL: SURVIVAL"
        setcvar "g_obj_alliedtext1" "SURVIVAL  -  one Survivor vs the horde"
        setcvar "g_obj_alliedtext2" "Survivor has a SHOTGUN. Outlast the timer to win."
        setcvar "g_obj_alliedtext3" "Infected are melee-only. Kill the Survivor to end it."
    }
    else if (level.gameMode == 1)
    {
        level.28fl_modeName = "OUTBREAK"
        setcvar "g_gametypestring" "28FL: OUTBREAK"
        setcvar "g_obj_alliedtext1" "OUTBREAK  -  up to 3 Survivors, co-op"
        setcvar "g_obj_alliedtext2" "Survivors have SHOTGUNS. Stay alive together."
        setcvar "g_obj_alliedtext3" "Die and you JOIN the infected. Last team standing wins."
    }
    else
    {
        level.28fl_modeName = "INFECTION"
        setcvar "g_gametypestring" "28FL: INFECTION"
        setcvar "g_obj_alliedtext1" "INFECTION  -  everyone starts a Survivor"
        setcvar "g_obj_alliedtext2" "Survivors have PISTOLS. Survive 5 minutes to win."
        setcvar "g_obj_alliedtext3" "Get killed and you TURN. Don't let everyone fall."
    }
    setcvar "g_obj_axistext1" "28 Frags Later"
    setcvar "g_obj_axistext2" "map + mode rotate every 10 minutes"
    setcvar "g_obj_axistext3" "by DazRave"
end

// =====================================================================
//  Map + mode rotation (every 10 minutes)
// =====================================================================
rotation_timer:
    wait 600
    thread announce_winner
    wait 5
    local.maps[1] = "dm/lowdownmall2"
    local.maps[2] = "dm/the_alley"
    local.maps[3] = "dm/megapole"
    local.maps[4] = "dm/snowhill"
    local.maps[5] = "dm/STB01_dm_underground"
    local.maps[6] = "dm/tpm_final"
    local.next = int(getcvar("g_28fl_rot")) + 1
    setcvar "g_28fl_rot" string(local.next)
    local.mi = (local.next % 6) + 1
    map (local.maps[local.mi])
end

// =====================================================================
//  Spawn detection -> loadout (works for bots and humans)
// =====================================================================
player_manager:
    while (1)
    {
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.p = $player[local.i]
            if (!local.p.sh_managed)
            {
                local.p.sh_managed = 1
                local.p thread player_life
            }
        }
        wait 1
    }
end

player_life:
    while (1)
    {
        if (isAlive(self) && !self.sh_set)
        {
            self.sh_set = 1
            self thread setup_player
        }
        if (!isAlive(self))
            self.sh_set = 0
        wait 0.4
    }
end

setup_player:
    wait 0.1
    self takeall
    local.isSurv = 0
    if (!isBot(self) && self.dmteam == "allies")
        local.isSurv = 1

    if (local.isSurv)
    {
        // Survivor. Infection mode = pistol; otherwise a shotgun.
        if (level.gameMode == 2)
        {
            self item "models/weapons/colt45.tik"
            self useweaponclass pistol
        }
        else
        {
            self item "models/weapons/shotgun.tik"
            self useweaponclass heavy
        }
        self.health = 200
        self stufftext "dm_playermodel allied_Magna_Cartas_police"
    }
    else
    {
        // Infected (bot OR non-survivor human). Engine keeps the colt45 dry
        // (g_infected_disarm) so it falls back to its melee secondary.
        self item "models/weapons/colt45.tik"
        if (!isBot(self))
            self stufftext "dm_playergermanmodel german_zombie"
    }
end

// Bots are ALWAYS the infected horde.
bot_enforcer:
    while (1)
    {
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            if (isBot($player[local.i]) && $player[local.i].dmteam != "axis")
                $player[local.i] setteam axis
        }
        wait 0.5
    }
end

// =====================================================================
//  Helpers
// =====================================================================
countInfected:
    local.n = 0
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        if ($player[local.i].dmteam == "axis")
            local.n++
    }
    end local.n
end

countHumansAlive:
    local.n = 0
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        if (!isBot($player[local.i]) && isAlive($player[local.i]))
            local.n++
    }
    end local.n
end

// Fair pick: a living human with the fewest previous survivor turns.
pickFairSurvivor:
    local.least = 999999
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        local.p = $player[local.i]
        if (!isBot(local.p) && isAlive(local.p))
        {
            local.amt = local.p.survivalAmount
            if (local.amt == NIL)
                local.amt = 0
            if (local.amt < local.least)
                local.least = local.amt
        }
    }
    local.tries = 0
    while (local.tries < 60)
    {
        local.c = $player[randomint($player.size) + 1]
        if (!isBot(local.c) && isAlive(local.c))
        {
            local.amt = local.c.survivalAmount
            if (local.amt == NIL)
                local.amt = 0
            if (local.amt <= local.least)
                end local.c
        }
        local.tries++
        waitframe
    }
    // fallback: first living human
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        if (!isBot($player[local.i]) && isAlive($player[local.i]))
            end $player[local.i]
    }
    end NIL
end

secStr local.n:
    local.s = ""
    if (local.n < 10)
        local.s = "0"
    local.s = local.s + string(local.n)
    end local.s
end

// =====================================================================
//  MODE 3 - SURVIVAL  (one rotating survivor, dynamic timer, survive to win)
// =====================================================================
mode_survival:
    level.28fl_expiry = 0
    wait 8
    while (1)
    {
        local.hasSurvivor = 0
        local.survName = "---"
        // one living human survivor; dead/extra allies -> infected
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.p = $player[local.i]
            if (!isBot(local.p) && local.p.dmteam == "allies")
            {
                if (isAlive(local.p) && local.hasSurvivor == 0)
                {
                    local.hasSurvivor = 1
                    local.survName = local.p.netname
                }
                else
                    local.p setteam axis
            }
        }
        // WIN: survivor outlasted the timer
        if (local.hasSurvivor == 1 && level.28fl_expiry > 0 && level.time >= level.28fl_expiry)
        {
            iprintlnbold_noloc (local.survName + " SURVIVED THE ROUND  -  Winner!")
            for (local.i = 1; local.i <= $player.size; local.i++)
            {
                if (!isBot($player[local.i]) && $player[local.i].dmteam == "allies")
                    $player[local.i] setteam axis
            }
            local.hasSurvivor = 0
            level.28fl_expiry = 0
        }
        // pick a new survivor if none
        if (local.hasSurvivor == 0)
        {
            if (level.28fl_expiry > 0)
                iprintlnbold_noloc "The Survivor was infected!  Choosing another..."
            level.28fl_expiry = 0
            local.s = waitthread pickFairSurvivor
            if (local.s != NIL)
            {
                if (local.s.survivalAmount == NIL)
                    local.s.survivalAmount = 0
                local.s.survivalAmount = local.s.survivalAmount + 1
                local.s setteam allies
                local.inf = waitthread countInfected
                local.tl = 300 * (100 - (local.inf * 5)) / 100
                if (local.tl < 60)
                    local.tl = 60
                level.28fl_expiry = level.time + local.tl
                local.hasSurvivor = 1
                local.survName = local.s.netname
                local.mm = int(local.tl / 60)
                local.rem = local.tl % 60
                local.ss = waitthread secStr local.rem
                iprintlnbold_noloc (local.s.netname + " is the SURVIVOR  -  outlast " + string(local.mm) + ":" + local.ss + "  (" + string(local.inf) + " infected)")
            }
        }
        level.28fl_survalive = local.hasSurvivor
        level.28fl_survname = local.survName
        wait 0.5
    }
end

// =====================================================================
//  MODE 1 - OUTBREAK  (up to 3 co-op survivors, last team standing)
// =====================================================================
mode_outbreak:
    level.28fl_ob_active = 0
    wait 8
    while (1)
    {
        // count living survivors; dead survivors -> infected
        local.alive = 0
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.p = $player[local.i]
            if (!isBot(local.p) && local.p.dmteam == "allies")
            {
                if (local.p.obSurv == 1 && isAlive(local.p))
                    local.alive++
                else
                {
                    // dead survivor, or a stray/late-joiner on allies -> infected
                    local.p.obSurv = 0
                    local.p setteam axis
                }
            }
        }

        if (level.28fl_ob_active == 1 && local.alive == 0)
        {
            iprintlnbold_noloc "All Survivors infected  -  the horde wins!"
            level.28fl_ob_active = 0
            wait 6
        }

        if (level.28fl_ob_active == 0)
        {
            local.got = waitthread selectOutbreak
            if (local.got > 0)
            {
                level.28fl_ob_active = 1
                iprintlnbold_noloc (string(local.got) + " SURVIVORS chosen  -  work together, stay alive!")
                local.alive = local.got
            }
        }

        level.28fl_survalive = 0
        if (local.alive > 0)
            level.28fl_survalive = 1
        level.28fl_survname = "TEAM x" + string(local.alive)
        wait 0.5
    }
end

selectOutbreak:
    // reset everyone to infected first
    for (local.i = 1; local.i <= $player.size; local.i++)
    {
        if (!isBot($player[local.i]))
        {
            $player[local.i].obSurv = 0
            if ($player[local.i].dmteam == "allies")
                $player[local.i] setteam axis
        }
    }
    local.count = 0
    local.tries = 0
    while (local.count < 3 && local.tries < 100)
    {
        local.c = $player[randomint($player.size) + 1]
        if (!isBot(local.c) && isAlive(local.c) && local.c.obSurv != 1)
        {
            local.c.obSurv = 1
            local.c setteam allies
            local.c iprint "You are a SURVIVOR - work together!"
            local.count++
        }
        local.tries++
        waitframe
    }
    end local.count
end

// =====================================================================
//  MODE 2 - INFECTION  (all survivors + pistols, killed -> infected, 5 min)
// =====================================================================
mode_infection:
    level.28fl_inf_active = 0
    level.28fl_inf_expiry = 0
    wait 8
    while (1)
    {
        if (level.28fl_inf_active == 0)
        {
            local.h = waitthread countHumansAlive
            if (local.h >= 1)
            {
                for (local.i = 1; local.i <= $player.size; local.i++)
                {
                    local.p = $player[local.i]
                    if (!isBot(local.p) && isAlive(local.p))
                    {
                        local.p.infSurv = 1
                        local.p.infDead = 0
                        if (local.p.dmteam != "allies")
                            local.p setteam allies
                    }
                }
                level.28fl_inf_active = 1
                level.28fl_inf_expiry = level.time + 300
                iprintlnbold_noloc "INFECTION OUTBREAK!  Survive 5 minutes - don't get touched!"
            }
        }
        else
        {
            local.sv = 0
            for (local.i = 1; local.i <= $player.size; local.i++)
            {
                local.p = $player[local.i]
                if (!isBot(local.p))
                {
                    if (local.p.dmteam == "allies" && local.p.infSurv == 1)
                    {
                        if (!isAlive(local.p))
                            local.p.infDead = 1
                        else if (local.p.infDead == 1)
                        {
                            // respawned after dying -> infect now
                            local.p.infDead = 0
                            local.p.infSurv = 0
                            local.p setteam axis
                            local.p iprint "You have been INFECTED!"
                        }
                        else
                            local.sv++
                    }
                    else if (local.p.dmteam == "allies" && local.p.infSurv != 1)
                    {
                        // late joiner -> infected
                        local.p setteam axis
                    }
                }
            }

            level.28fl_survalive = 0
            if (local.sv > 0)
                level.28fl_survalive = 1
            level.28fl_survname = "SURVIVORS x" + string(local.sv)

            if (level.time >= level.28fl_inf_expiry)
            {
                iprintlnbold_noloc "TIME UP  -  the Survivors made it. Survivors win!"
                level.28fl_inf_active = 0
                wait 6
            }
            else if (local.sv == 0)
            {
                iprintlnbold_noloc "Everyone has been infected  -  the outbreak wins!"
                level.28fl_inf_active = 0
                wait 6
            }
        }
        wait 0.5
    }
end

// =====================================================================
//  Session survivor leaderboard (totals across the whole rotation)
// =====================================================================
winner_tally:
    if (game.wcount == NIL)
        game.wcount = 0
    while (1)
    {
        wait 1
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            local.p = $player[local.i]
            if (!isBot(local.p) && local.p.dmteam == "allies" && isAlive(local.p))
            {
                local.idx = 0
                for (local.k = 1; local.k <= game.wcount; local.k++)
                {
                    if (game.wname[local.k] == local.p.netname)
                        local.idx = local.k
                }
                if (local.idx == 0)
                {
                    game.wcount = game.wcount + 1
                    local.idx = game.wcount
                    game.wname[local.idx] = local.p.netname
                    game.wsecs[local.idx] = 0
                }
                game.wsecs[local.idx] = game.wsecs[local.idx] + 1
            }
        }
    }
end

announce_winner:
    if (game.wcount == NIL || game.wcount == 0)
    {
        iprintlnbold_noloc "No survivor times recorded yet."
        end
    }
    local.best = -1
    local.bestName = "nobody"
    for (local.k = 1; local.k <= game.wcount; local.k++)
    {
        if (game.wsecs[local.k] > local.best)
        {
            local.best = game.wsecs[local.k]
            local.bestName = game.wname[local.k]
        }
    }
    local.mm = int(local.best / 60)
    local.rem = local.best % 60
    local.ss = waitthread secStr local.rem
    iprintlnbold_noloc ("*** SESSION LEADER: " + local.bestName + "  -  " + string(local.mm) + ":" + local.ss + " survived total ***")
end

// =====================================================================
//  HUD banner
// =====================================================================
score_hud:
    wait 3
    while (1)
    {
        local.infected = waitthread countInfected
        if (level.28fl_survalive == 1)
            level.28fl_survtime = level.28fl_survtime + 1
        else
            level.28fl_survtime = 0

        local.mm = int(level.28fl_survtime / 60)
        local.rem = level.28fl_survtime % 60
        local.ss = waitthread secStr local.rem
        local.tstr = string(local.mm) + ":" + local.ss

        huddraw_align 108 left top
        huddraw_virtualsize 108 1
        huddraw_rect 108 150 8 480 20
        huddraw_color 108 1 0.25 0.25
        huddraw_alpha 108 1
        huddraw_font 108 facfont-20
        huddraw_string 108 ("[" + level.28fl_modeName + "]  " + level.28fl_survname + "   TIME " + local.tstr + "   Infected " + string(local.infected))
        wait 1
    }
end

// =====================================================================
//  Atmosphere
// =====================================================================
storm:
    while (1)
    {
        wait (10 + randomint(14))
        $world farplane_color ( 0.85 0.85 0.9 )
        $world playsound thunder1
        wait 0.1
        $world farplane_color ( 0.12 0.12 0.14 )
    }
end

creepy_sounds:
    wait 6
    while (1)
    {
        local.n = randomint(4) + 1
        if (local.n == 1)
            $world playsound creak1
        if (local.n == 2)
            $world playsound creak2
        if (local.n == 3)
            $world playsound snap1
        if (local.n == 4)
            $world playsound snap2
        wait (7 + randomint(12))
    }
end

dynamic_music:
    local.music[1] = "sound/music/mus_06a_mystery.mp3"
    local.music[2] = "sound/music/mus_15a_mystery.mp3"
    local.music[3] = "sound/music/mus_16a_mystery.mp3"
    wait 4
    while (1)
    {
        local.num = randomint(3) + 1
        for (local.i = 1; local.i <= $player.size; local.i++)
        {
            if (!isBot($player[local.i]))
                $player[local.i] stufftext ("tmstop;tmstart " + local.music[local.num])
        }
        wait 200
    }
end

telemetry:
    wait 5
    while (1)
    {
        println ("[28FL_TELEMETRY] mode=" + string(level.gameMode) + " players=" + string($player.size) + " survalive=" + string(level.28fl_survalive) + " survtime=" + string(level.28fl_survtime))
        wait 15
    }
end
